# Harmonia AWS edition. Copy to .env.local; never commit credentials.
AWS_REGION=us-east-1
# Must stay false until the operator authorizes paid validation.
HARMONIA_ALLOW_PAID_AWS=false
HARMONIA_ENABLE_QUEUE_CONSUMERS=false
HARMONIA_ENABLE_RESIDENT_AUTONOMY=false
GENERATIVE_MEDIA_ENABLED=false

INTERNAL_API_TOKEN=
AGENT_SERVICE_URL=http://localhost:8080
WEB_INTERNAL_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
ATTACHMENT_ALLOWED_ORIGINS=http://localhost:3000
DYNAMODB_TABLE=harmonia
S3_BUCKET=
# Optional loopback-only local service endpoint; never a production fallback.
AWS_LOCAL_ENDPOINT=
SQS_STAGE_QUEUE_URL=
SQS_PRODUCTION_QUEUE_URL=
SQS_DATA_QUEUE_URL=
SQS_CONTROL_QUEUE_URL=

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
HARMONIA_CONNECTION_ENVELOPE_KEY=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

AGENTCORE_RUNTIME_ARN=
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_SEARCH_TOOL=web-search___WebSearch
EMBEDDING_INPUT_USD_PER_MILLION=
EMBEDDING_PRICING_VERSION=
BEDROCK_DATA_SOURCE_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
MEMORY_BANK_ENABLED=true
MODEL_PRICING_VERSION=aws-configured-2026-09-10
BEDROCK_TEXT_PRICING_JSON={}
DREAM_MAX_COST_USD=
PRODUCTION_PLANNER_MAX_COST_USD=
COORDINATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
STRATEGIST_MODEL_ID=us.anthropic.claude-sonnet-4-6
ANALYST_MODEL_ID=us.amazon.nova-2-lite-v1:0
COPYWRITER_MODEL_ID=us.anthropic.claude-sonnet-4-6
EDITOR_MODEL_ID=us.anthropic.claude-sonnet-4-6
PLANNER_MODEL_ID=us.anthropic.claude-sonnet-4-6
PRESENTER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
LIAISON_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Configure verified prices before enabling provider operations.
TRANSCRIBE_COST_PER_SECOND_USD=
NOVA_REEL_COST_PER_SECOND_USD=
NOVA_CANVAS_COST_PER_IMAGE_USD=
ELEVENLABS_MUSIC_COST_PER_SECOND_USD=
ELEVENLABS_API_KEY=
IMAGE_MAX_COST_USD=0.500000
DEFAULT_JOB_BUDGET_USD=5.00
DEFAULT_JOB_APPROVAL_THRESHOLD_USD=0.25
DEFAULT_WORKSPACE_BUDGET_USD=100.00
HARMONIA_WORKSPACE_TIMEZONE=Africa/Lagos
HARMONIA_TELEMETRY_ENABLED=false
HARMONIA_TELEMETRY_SAMPLE_RATE=1.0
OTEL_SERVICE_NAME=harmonia-worker
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Official external connectors; configure independently of the old deployment.
YOUTUBE_API_KEY=
# TikTok Content Posting API: app credentials + user access token after OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API: Meta app + token from a linked Professional account
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIGURATION_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn: OAuth 2.0 app (w_member_social / w_organization_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Facebook Pages: Meta app + Page access token (pages_manage_posts)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_TOKEN=

# Google OAuth web client shared by YouTube and Google Calendar. Calendar asks
# only for calendar.app.created and writes to a dedicated Harmonia calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# X OAuth 2.0 user authorization for official API publishing/readback.
X_CLIENT_ID=
X_CLIENT_SECRET=
